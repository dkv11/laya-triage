# Copy this file to .env and fill in your own values. Never commit .env.

# LLM fallback (any OpenAI-compatible API)
OPENROUTER_API_KEY=your_openrouter_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-omni-flash

# Local Ollama instead of OpenRouter:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=laya

# Fine-tuned Laya checkpoint folder (leave unset to use the base laya-multilingual model)
# LAYA_CHECKPOINT=checkpoints/laya-maint-v1

# After the first run has downloaded the Laya model, skip online checks:
# HF_HUB_OFFLINE=1
